enum TenantStatus {
  ACTIVE
  FORMER
  NOTICE_GIVEN
  ARCHIVED
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  EXPIRING
  TERMINATED
  EXPIRED
  RENEWED
}

model Tenant {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  landlordId       String       @db.Uuid
  propertyId       String       @db.Uuid
  unitId           String?      @db.Uuid
  firstName        String
  lastName         String
  email             String
  emailVerifiedAt   DateTime?
  emailVerifyHash   String?       @unique
  emailVerifyExpiry DateTime?
  phone            String?
  occupation       String?
  employer         String?
  emergencyContact Json?
  guarantorName    String?
  guarantorContact String?
  identification   Json?
  status           TenantStatus @default(ACTIVE)
  notes            String?
  archivedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  landlord       Landlord             @relation(fields: [landlordId], references: [id], onDelete: Restrict)
  property       Property             @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unit           Unit?                @relation(fields: [unitId], references: [id], onDelete: SetNull)
  leases         Lease[]
  payments       Payment[]
  maintenance    MaintenanceRequest[]
  documents      Document[]
  communications Communication[]
  transactions   Transaction[]
  inspections    Inspection[]
  complaints     Complaint[]

  @@index([organizationId, landlordId, status])
  @@index([organizationId, propertyId, unitId])
  @@map("tenants")
}

model Lease {
  id                String      @id @default(uuid()) @db.Uuid
  organizationId    String      @db.Uuid
  landlordId        String      @db.Uuid
  propertyId        String      @db.Uuid
  unitId            String      @db.Uuid
  tenantId          String      @db.Uuid
  startDate         DateTime
  endDate           DateTime
  rentAmount        Decimal     @db.Decimal(14, 2)
  securityDeposit   Decimal     @db.Decimal(14, 2)
  paymentSchedule   String      @default("monthly")
  status            LeaseStatus @default(DRAFT)
  signedDocumentId  String?
  terminationDate   DateTime?
  terminationReason String?
  previousLeaseId   String?     @unique @db.Uuid
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  landlord       Landlord        @relation(fields: [landlordId], references: [id], onDelete: Restrict)
  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unit           Unit            @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rentCharges    RentCharge[]
  previousLease  Lease?          @relation("LeaseRenewal", fields: [previousLeaseId], references: [id], onDelete: SetNull)
  nextLease      Lease?          @relation("LeaseRenewal")
  documents      Document[]
  communications Communication[]

  @@index([organizationId, landlordId, status])
  @@index([organizationId, unitId, status])
  @@index([organizationId, tenantId])
  @@map("leases")
}

model RentCharge {
  id          String   @id @default(uuid()) @db.Uuid
  leaseId     String   @db.Uuid
  dueDate     DateTime
  amountDue   Decimal  @db.Decimal(14, 2)
  amountPaid  Decimal  @default(0) @db.Decimal(14, 2)
  status      String   @default("pending")
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lease       Lease               @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  @@unique([leaseId, periodStart, periodEnd])
  @@index([leaseId, dueDate])
  @@map("rent_charges")
}
