NODE_ENV=development
PORT=4000

# Docker PostgreSQL exposed by ../docker-compose.yml.
DATABASE_URL="postgresql://shelta_user:shelta_password@localhost:5435/shelta_db?schema=public"
DIRECT_URL="postgresql://shelta_user:shelta_password@localhost:5435/shelta_db?schema=public"

DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
FRONTEND_URL="http://localhost:3001"

STORAGE_LOCAL_ROOT="./storage"

# Required by `npm run seed`; use a unique value with at least 12 characters.
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL="admin@shelta.local"
SUPERADMIN_PASSWORD=""
ORGANIZATION_NAME="Shelta Organization"
ORGANIZATION_LEGAL_NAME="Shelta Real Estate Management"
ORGANIZATION_PHONE="+234801234567"
ORGANIZATION_ADDRESS="123 Victoria Island, Lagos"

JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# Mailpit defaults for local development. Add provider credentials in production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="no-reply@shelta.local"
SMTP_FROM_NAME="Shelta"

# AI is opt-in. Configure a provider only when you are ready to enable it.
AI_ENABLED="false"
AI_DEFAULT_PROVIDER_TYPE="OPENAI_COMPATIBLE"
AI_DEFAULT_PROVIDER_NAME="deployment-gateway"
AI_DEFAULT_BASE_URL=""
AI_DEFAULT_API_KEY=""
AI_DEFAULT_MODEL_ID=""
AI_MAX_TOOL_STEPS=5
AI_MAX_OUTPUT_TOKENS=400

# For AgentRouter Anthropic-compatible models, use the provider root URL:
# AI_DEFAULT_PROVIDER_TYPE="ANTHROPIC"
# AI_DEFAULT_BASE_URL="https://agentrouter.org"
# AI_DEFAULT_MODEL_ID="claude-opus-4-6"

# Leave disabled unless Redis is configured.
JOBS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
