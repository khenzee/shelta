NODE_ENV=development
PORT=4000

# Supabase runtime connection. Prefer the transaction pooler (port 6543).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&sslmode=require"

# Supabase migration/Prisma CLI connection. Use direct or session mode (port 5432).
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
FRONTEND_URL="http://localhost:3001"

SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="documents"

JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# Leave disabled unless Redis is configured.
JOBS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
